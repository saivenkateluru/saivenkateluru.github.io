---
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
}

const {
  title = "Eluru Sai Venkat",
  description = "Eluru Sai Venkat — M.Tech AI student at IISc working on self-improving agents, continual learning, and inference optimization.",
  article = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const nav = [
  ["Academics", "/academics/"],
  ["Blog", "/blog/"],
  ["Publications", "/publications/"],
  ["Projects", "/projects/"],
];

const socialLinks = [
  {
    label: "Eluru Sai Venkat on X",
    href: "https://x.com/EluruSaiVenkat",
    path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  },
  {
    label: "Eluru Sai Venkat on LinkedIn",
    href: "https://www.linkedin.com/in/sai-venkat-eluru-737893191/",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM6.814 20.452H3.861V9h2.953z",
  },
  {
    label: "Eluru Sai Venkat on GitHub",
    href: "https://github.com/saivenkateluru",
    path: "M12 .297a12 12 0 0 0-3.79 23.39c.6.113.82-.258.82-.577v-2.234c-3.338.726-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.085 1.839 1.237 1.839 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.303-5.466-1.332-5.466-5.93 0-1.31.468-2.381 1.235-3.221-.124-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.301 1.23a11.5 11.5 0 0 1 6.008 0c2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.873.119 3.176.769.84 1.233 1.911 1.233 3.221 0 4.61-2.806 5.624-5.479 5.921.43.371.814 1.102.814 2.222v3.293c0 .322.216.694.825.576A12 12 0 0 0 12 .297z",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title === "Eluru Sai Venkat" ? title : `${title} · Eluru Sai Venkat`}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const systemTheme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      document.documentElement.dataset.theme = savedTheme || systemTheme;
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-name" href="/">Eluru Sai Venkat</a>
        <nav aria-label="Primary navigation">
          {
            nav.map(([label, href]) => (
              <a href={href} aria-current={pathname.startsWith(href) ? "page" : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
        <div class="header-actions">
          {
            socialLinks.map(({ label, href, path }) => (
              <a href={href} aria-label={label} class="social-link">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg>
              </a>
            ))
          }
          <button id="theme-toggle" type="button" aria-label="Switch to light theme">go light</button>
        </div>
      </div>
    </header>

    <main class:list={["page-shell", article && "article-shell"]}>
      <slot />
    </main>

    <footer>
      <span>Eluru Sai Venkat</span>
      <span>Built for learning in public.</span>
    </footer>

    <script is:inline>
      const themeButton = document.querySelector("#theme-toggle");
      const media = matchMedia("(prefers-color-scheme: dark)");

      const updateThemeButton = () => {
        const dark = document.documentElement.dataset.theme === "dark";
        themeButton.textContent = dark ? "go light" : "go dark";
        themeButton.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
      };

      themeButton.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
        updateThemeButton();
      });

      media.addEventListener("change", (event) => {
        if (localStorage.getItem("theme")) return;
        document.documentElement.dataset.theme = event.matches ? "dark" : "light";
        updateThemeButton();
      });

      updateThemeButton();
    </script>
  </body>
</html>
